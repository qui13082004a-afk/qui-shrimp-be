            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{paymentId}}\",\n  \"requestId\": \"REQ-{{$timestamp}}\",\n  \"amount\": 240000,\n  \"resultCode\": 0,\n  \"transId\": \"MOMO-{{$timestamp}}\",\n  \"message\": \"Successful\",\n  \"signature\": \"test-signature\"\n}" },
            "url": "{{baseUrl}}/payments/momo-callback"
          }
        }
      ]
    },
    {
      "name": "Deliveries",
      "item": [
        {
          "name": "Assign Delivery",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data && json.data.id_giao_hang) pm.collectionVariables.set('deliveryId', json.data.id_giao_hang);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_don_hang\": \"{{orderId}}\",\n  \"id_nhan_vien_giao\": \"{{deliveryStaffUserId}}\"\n}" },
            "url": "{{baseUrl}}/deliveries/assign"
          }
        },
        { "name": "Get My Deliveries", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }], "url": "{{baseUrl}}/deliveries/my" } },
        { "name": "Get All Deliveries Admin", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/deliveries/admin" } },
        { "name": "Get Delivery By Id", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/deliveries/{{deliveryId}}" } },
        { "name": "Start Delivery", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }], "url": "{{baseUrl}}/deliveries/{{deliveryId}}/start" } },
        {
          "name": "Success Delivery",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"anh_bien_nhan\": \"https://example.com/bien-nhan.jpg\",\n  \"anh_hop_dong\": \"https://example.com/hop-dong.jpg\",\n  \"ghi_chu\": \"Giao hang thanh cong\"\n}" },
            "url": "{{baseUrl}}/deliveries/{{deliveryId}}/success"
          }
        },
        {
          "name": "Fail Delivery",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ly_do_that_bai\": \"Khach hen lai\",\n  \"ghi_chu\": \"Test giao that bai\"\n}" },
            "url": "{{baseUrl}}/deliveries/{{deliveryId}}/fail"
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Single Image",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "{{sampleImagePath}}" }] },
            "url": "{{baseUrl}}/upload/single"
          }
        },
        {
          "name": "Upload Multiple Images",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "images", "type": "file", "src": "{{sampleImagePath}}" }] },
            "url": "{{baseUrl}}/upload/multiple"
          }
        }
      ]
    }
  ]
}
