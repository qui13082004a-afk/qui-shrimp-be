      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ho_ten\": \"Khach Hang Test\",\n  \"email\": \"{{customerEmail}}\",\n  \"so_dien_thoai\": \"0901234567\",\n  \"mat_khau\": \"{{customerPassword}}\",\n  \"dia_chi\": \"123 Duong Test\",\n  \"tinh_thanh\": \"Ca Mau\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Verify Email",
